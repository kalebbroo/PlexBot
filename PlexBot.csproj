<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- Exclude extension source code from host compilation — extensions are separate projects -->
	<ItemGroup>
		<Compile Remove="Extensions\**" />
		<Content Remove="Extensions\**" />
		<EmbeddedResource Remove="Extensions\**" />
		<None Remove="Extensions\**" />
		<Compile Remove="Tests\**" />
		<Compile Remove="Tools\**" />
		<Content Remove="Tests\**" />
		<EmbeddedResource Remove="Tests\**" />
		<None Remove="Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PlexBot.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Discord.Net" Version="3.20.2" />
		<PackageReference Include="DotNetEnv" Version="3.1.1" />
		<PackageReference Include="FreneticLLC.FreneticUtilities" Version="1.1.4" />
		<PackageReference Include="Lavalink4NET.Discord.NET" Version="4.2.2" />
		<PackageReference Include="Lavalink4NET.InactivityTracking" Version="4.2.2" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="SkiaSharp" Version="4.153.1" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
	</ItemGroup>

</Project>
